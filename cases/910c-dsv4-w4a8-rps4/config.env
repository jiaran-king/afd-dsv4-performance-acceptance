# The fixed 910C acceptance case. Site-specific paths are in site.env.
export SERVED_MODEL_NAME=dsv4
export PREFILL_TOPOLOGY=legacy PREFILL_NODE_ID=0 PREFILL_ENABLE_KV_CONNECTOR=0
export MAX_MODEL_LEN=65536 BLOCK_SIZE=128 DSV4_INDEXER_KV_DTYPE=int8
export BASELINE_VLLM_PLUGINS=ascend,ascend_model,ascend_model_loader,ascend_service_profiling
export AFD_VLLM_PLUGINS=ascend,ascend_model,ascend_model_loader,ascend_service_profiling,afd
export AFD_FORCE_BALANCED_TOPK_IDS=0 AFD_CAM_OP_IO_LOG=0 AFD_ASYNC_MOE_LAYOUT_LOG=0
export PREFILL_FLASHCOMM1=1 ENABLE_CPU_BINDING=true
export PREFILL_PORT=7100 FFN_PORT=7101
export PREFILL_DP_RPC_PORT=12321
export AFD_PORT=1239

# Baseline P and AFD P values are selected by role in scripts/launch.sh.
BASELINE_MBT=8192
BASELINE_MAX_SEQS=8
BASELINE_UTILIZATION=0.9
BASELINE_DP=2
BASELINE_TP=4
AFD_MBT=16384
AFD_MAX_SEQS=16
AFD_UTILIZATION=0.7
AFD12_A_DP=3
AFD12_A_TP=4
AFD8_A_DP=4
AFD8_A_TP=2
export PREFILL_ENABLE_DBO=1
export PREFILL_DBO_PREFILL_TOKEN_THRESHOLD=512 PREFILL_DBO_DECODE_TOKEN_THRESHOLD=32
export FFN_MAX_NUM_SEQS=16
export AFD_ASYNC_CAM_LAYERED_GMM=1 BATCH_SIZE_FACTOR=0.25
